# Copy this file to `.env` and adjust if needed.
# Everything here has a working default, so `.env` is optional for local development.

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Comma separated list of origins allowed to call this API.
# Use * to allow any origin (fine for a local demo).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Database ---
# Path to the SQLite file, relative to the web_backend folder.
DATABASE_FILE=data/packmen.db

# --- Auth ---
# CHANGE THIS before running anywhere other than your own laptop.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10

# --- Seed admin account (created by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@packmen.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=PackMen Admin

# --- ML / simulation backend ---
# Where ml_backend is running. The collector subscribes to its /ws stream and
# records the simulation's missions and disasters as permanent history.
ML_BACKEND_URL=http://localhost:8000

# Set to false to run this service completely standalone (no connection to the
# simulation at all). Everything else keeps working.
COLLECTOR_ENABLED=true

# Register a vehicle automatically the first time a simulation unit is seen, so
# missions always have a vehicle attached.
COLLECTOR_AUTO_REGISTER_VEHICLES=true
