{
  "name": "packmen-web-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Web backend for PackMen - authentication, users, fleet, hospitals, incidents and mission history. Runs alongside the ML/simulation backend.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "node tests/smoke.test.js && node tests/integration.test.js",
    "test:api": "node tests/smoke.test.js",
    "test:integration": "node tests/integration.test.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
