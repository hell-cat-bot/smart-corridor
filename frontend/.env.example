# Copy to `.env`. Both values have working defaults for running everything
# locally, so `.env` is optional.
#
# Vite only exposes variables that start with VITE_, and it reads this file at
# dev-server start — restart `npm run dev` after changing it.

# web_backend — accounts, fleet register, incident and mission history.
VITE_API_URL=http://localhost:4000

# ml_backend — the simulation and the ML hazard detector.
VITE_SIM_URL=http://localhost:8000

# Which engine drives the live map on first load: `server` (ml_backend, the
# default) or `local` (the browser's own engine, no backend needed).
# You can switch at any time from the pill in the top bar; your choice is
# remembered in this browser.
VITE_SIM_SOURCE=server
